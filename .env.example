# Copy this file to ".env" (same folder) and fill in the two values.

# 1. Your Groq API key (starts with gsk_). Get one free at https://console.groq.com/keys
GROQ_API_KEY=

# 2. Who you are, for the SEC. The SEC requires a name and email in every request.
#    Example: SEC_USER_AGENT=PharmaDash Newsletter jane@example.com
SEC_USER_AGENT=
