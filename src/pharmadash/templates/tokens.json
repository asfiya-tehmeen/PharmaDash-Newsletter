{
  "_note": "Design tokens extracted from the 14 sample dashboards in examples/. All share these base values; only the accent and panel shade vary.",
  "base": {
    "page": "#E9EDF1", "card": "#FFFFFF", "ink": "#101620", "muted": "#5C6775",
    "faint": "#8A95A3", "hair": "#DBE0E7",
    "amber": "#B45309", "amber_bg": "#FBF0DF", "amber_line": "#E7C58C"
  },
  "panel_shades": ["#0B1017", "#0B131A", "#0C1118", "#0C1119", "#0E1016", "#0E141B"],
  "default_panel": "#0E141B",
  "fonts": {
    "heading": "Space Grotesk", "body": "Inter", "mono": "IBM Plex Mono",
    "google_css": "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
  },
  "breakpoints": {"tablet": 780, "phone": 430},
  "max_width": 1060,
  "accents_seen": {
    "M&A": "#10916B", "M&A deals": "#7A3FF2", "GLP-1 Novo": "#1F5FE0", "GLP-1 Lilly": "#E5223C",
    "AI": "#0CB5C4", "AI pharma": "#5B8DEF", "China": "#D22A38", "Pricing": "#1C8C6A",
    "Global markets money": "#C6893F", "Global markets people": "#2E9E8F", "Patent cliff danger": "#D8312A",
    "Gold highlight": "#E0A100"
  },
  "chart_conventions": {
    "projected": "hatched fill (45deg stripes) + dashed outline + '~' prefix on labels",
    "unavailable": "dashed outline, muted label 'n/d'",
    "gridline_on_dark": "#1E2935",
    "axis_text_on_dark": "#6F7E90",
    "label_font": "IBM Plex Mono",
    "number_font": "Space Grotesk"
  },
  "layout_blocks": ["eyebrow", "h1 with .em highlight", "dek", "4 KPI cards", "dark chart panel + legend", "mini chart + 'Reading' block (4 bullets)", "footer: Sources + Important caveats"]
}
